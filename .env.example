# Copy to .env (git-ignored). Only needed to rebuild from the raw dataset; the site and `heirloom verify --no-db`
# need nothing here.

# Hugging Face token with access to the gated dataset aidigestorg/ai-village (accept its terms first).
HF_TOKEN=

# LLM calls go through OpenRouter, asking only for providers that don't keep or train on prompts.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL_CHEAP=openai/gpt-6-luna
LLM_MODEL_STRONG=google/gemini-3.8-flash
# Hard cap on the project's total LLM spend (summed from cache/llm). Unset = no new paid calls at all.
LLM_SPEND_LIMIT_USD=

# Optional: DuckDB memory cap (default 6GB) and where the repo lives (default: found from this file).
# HEIRLOOM_DUCKDB_MEMORY=4GB
# HEIRLOOM_ROOT=
